{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mika",
  "version": "0.1.0",
  "identifier": "ai.vizzio.mika",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mika",
        "width": 416,
        "height": 739,
        "minWidth": 360,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "visible": false,
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "publisher": "Jon Lee",
    "copyright": "Copyright © 2026 Jon Lee",
    "category": "DeveloperTool",
    "shortDescription": "Watches your AI coding agents from the menu bar.",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
